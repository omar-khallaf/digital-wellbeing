{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "STRING",
          "value": "Release"
        },
        "CMAKE_C_COMPILER": {
          "type": "STRING",
          "value": "gcc"
        },
        "CMAKE_CXX_COMPILER": {
          "type": "STRING",
          "value": "g++"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "ON"
        },
        "BUILD_TESTING": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "linux-amd64",
      "displayName": "Linux amd64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": {
          "type": "STRING",
          "value": "Linux"
        },
        "CMAKE_SYSTEM_PROCESSOR": {
          "type": "STRING",
          "value": "x86_64"
        }
      }
    },
    {
      "name": "linux-aarch64",
      "displayName": "Linux aarch64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": {
          "type": "STRING",
          "value": "Linux"
        },
        "CMAKE_SYSTEM_PROCESSOR": {
          "type": "STRING",
          "value": "aarch64"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-amd64",
      "configurePreset": "linux-amd64"
    },
    {
      "name": "linux-aarch64",
      "configurePreset": "linux-aarch64"
    }
  ]
}
